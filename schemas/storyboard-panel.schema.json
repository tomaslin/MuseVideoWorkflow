{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Storyboard panel",
  "type": "object",
  "properties": {
    "panelId": {
      "type": "string"
    },
    "shotId": {
      "type": "string"
    },
    "size": {
      "type": "string"
    },
    "movement": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "soundCue": {
      "type": "string"
    },
    "tension": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "image": {
      "type": "string"
    }
  },
  "required": [
    "panelId",
    "shotId",
    "action",
    "tension"
  ]
}